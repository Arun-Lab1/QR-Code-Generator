<QRGeneratorScreen>:
    orientation: 'vertical'
    padding: [20, 20, 20, 20]  
    spacing: 15

    
    Label:
        text: "QR Code Generator"
        font_size: '24sp'  
        bold: True
        size_hint_y: None
        height: '50dp'     
        halign: 'center'
        valign: 'middle'
        text_size: self.size

    
    TextInput:
        id: url_input
        hint_text: "Text pour URL here..."
        multiline: False
        size_hint_y: None
        height: '50dp'
        font_size: '16sp'

    
    Button:
        text: "Generate QR Code"
        size_hint_y: None
        height: '55dp'
        font_size: '16sp'
        background_color: (0.15, 0.65, 0.35, 1)
        on_press: root.generate_qr()

    
    Image:
        id: qr_image
        source: ""
        size_hint_y: 1     
        allow_stretch: True
        keep_ratio: True

  
    Button:
        id: pdf_btn
        text: "Download as PDF"
        size_hint_y: None
        height: '55dp'
        font_size: '16sp'
        background_color: (0.2, 0.5, 0.85, 1)
        on_press: root.save_as_pdf()